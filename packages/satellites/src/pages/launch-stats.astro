---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<Layout title="Launch Statistics — labs.rjmlaird.co.uk">
  <div id="app">
    <Header
      crumb="launch stats"
      title="Launch Statistics"
      tagline="Satellites catalogued in Celestrak's SATCAT, aggregated by launch year and by owner/operator."
      active="launch-stats"
    >
      <span slot="status">
        <span class="badge wait" id="statusBadge"><span class="bdot"></span><span id="statusBadgeText">pre-launch</span></span>
      </span>
      <div slot="stat-bar" class="stat-bar">
        <div class="stat"><span class="lbl">Payloads</span><span class="val" id="statTotal">–</span></div>
        <div class="stat"><span class="lbl">Owners</span><span class="val" id="statOwners">–</span></div>
        <div class="stat"><span class="lbl">Years</span><span class="val" id="statYears">–</span></div>
        <div class="stat"><span class="lbl">Peak Year</span><span class="val" id="statPeak">–</span></div>
        <div class="grow"></div>
        <button id="reloadBtn">↻ Reload data</button>
      </div>
    </Header>

    <div class="main">
      <div class="stats-wrap">
        <section class="chart-section">
          <div class="section-head-static">
            <span class="st">Satellites launched per year</span>
            <span class="note">hover a bar for the exact count · scroll to see earlier years</span>
          </div>
          <div class="year-chart" id="yearChart"></div>
        </section>

        <section class="chart-section">
          <div class="section-head-static">
            <span class="st">Satellites launched by owner / operator</span>
            <span class="note" id="ownerNote"></span>
          </div>
          <div class="owner-toolbar">
            <input type="text" id="ownerSearch" placeholder="Filter owner/operator code…">
            <button id="toggleOwnersBtn">Show all</button>
          </div>
          <div class="owner-chart" id="ownerChart"></div>
        </section>

        <div id="tooltip"></div>

        <div class="overlay" id="overlay">
          <div class="ring"></div>
          <div class="msg" id="overlayMsg">Fetching SATCAT from Celestrak…</div>
        </div>
      </div>

      <aside class="sidebar">
        <div class="section-head"><span class="st">Methodology</span></div>
        <p class="methodology">
          Counts come from Celestrak's <b>SATCAT</b> catalog, filtered to records where
          <b>OBJECT_TYPE = PAY</b> — i.e. actual spacecraft, excluding rocket bodies and
          debris. Each record's <b>LAUNCH_DATE</b> year and <b>OWNER</b> code are then tallied.
          This reflects every catalogued payload ever launched, not just objects currently in
          orbit — it is independent of the catalog selected on the Ground Track page.
        </p>

        <hr class="sep">
        <a class="back-link" href="https://labs.rjmlaird.co.uk" target="_blank" rel="noopener">← labs.rjmlaird.co.uk</a>
      </aside>
    </div>

    <footer>
      <span>Data: <a href="https://celestrak.org/pub/satcat.csv" target="_blank" rel="noopener">Celestrak SATCAT</a>.</span>
      <span>launch-stats · rjmlaird-labs</span>
    </footer>
  </div>
</Layout>

<script>
  import '../scripts/launch-stats';
</script>
