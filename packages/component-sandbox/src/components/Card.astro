---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<div class="card">
  <h3>{title}</h3>
  <div class="body"><slot /></div>
</div>

<style>
  .card {
    background: #121826;
    border: 1px solid rgba(238, 242, 246, 0.08);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .card h3 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  .body {
    color: #9aa5b1;
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
