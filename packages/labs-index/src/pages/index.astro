---
import Base from "../layouts/Base.astro";
import experiments from "../data/experiments.json";

type Status = "active" | "in-progress" | "planned" | "archived";

type Experiment = {
  slug: string;
  title: string;
  group: string;
  status: Status;
  description: string;
  tech: string[];
  demoUrl?: string;
  repoUrl?: string;
  updated: string;
};

const labs = experiments as Experiment[];

const statusLabel: Record<Status, string> = {
  active: "Active",
  "in-progress": "In progress",
  planned: "Planned",
  archived: "Archived",
};

const statusOrder: Record<Status, number> = {
  active: 1,
  "in-progress": 2,
  planned: 3,
  archived: 4,
};

const groups = [
  {
    id: "space",
    title: "Space & Astronomy",
    description: "Orbital mechanics, satellite tracking and astronomy tools.",
  },
  {
    id: "climate",
    title: "Climate & Environment",
    description: "Climate communication, environmental risk and monitoring experiments.",
  },
  {
    id: "places",
    title: "Places & Infrastructure",
    description: "Local environmental data, infrastructure and place-based monitoring.",
  },
  {
    id: "maths-physics",
    title: "Maths & Physics",
    description: "Mechanics, graphs, equations and computational experiments.",
  },
  {
    id: "web-dev",
    title: "Web & Development",
    description: "Accessibility tools, interface experiments and reusable components.",
  },
];

const groupedLabs = groups
  .map((group) => ({
    ...group,
    experiments: labs.filter((experiment) => experiment.group === group.id),
  }))
  .filter((group) => group.experiments.length > 0);

const technologies = [
  ...new Set(labs.flatMap((experiment) => experiment.tech)),
].sort((a, b) => a.localeCompare(b));

const statuses: Status[] = [
  "active",
  "in-progress",
  "planned",
  "archived",
];
---

<Base
  title="Labs"
  description="Independent experiments in space, climate, local systems, maths, physics and web development."
>
  <header class="hero wrap">
    <div class="orbit-line" aria-hidden="true"></div>

    <p class="eyebrow">rjmlaird.co.uk / labs</p>

    <h1>Working experiments, not finished products.</h1>

    <p class="sub">
      Independent tools for space, climate, local systems, maths, physics and web
      development. Each lab runs separately; this is the shared launchpad for finding them.
    </p>
  </header>

  <main class="wrap">
    <section class="filters" aria-labelledby="filter-heading">
      <div class="filter-intro">
        <p class="section-kicker">Browse labs</p>
        <h2 id="filter-heading">Find an experiment</h2>
        <p>
          Narrow the collection by subject area, technology and development status,
          then choose how the results are ordered.
        </p>
      </div>

      <div class="filter-controls">
        <div class="filter-field">
          <label for="group-filter">Subject area</label>

          <select id="group-filter" name="group">
            <option value="all">All subject areas</option>

            {groupedLabs.map((group) => (
              <option value={group.id}>{group.title}</option>
            ))}
          </select>
        </div>

        <div class="filter-field">
          <label for="tech-filter">Technology</label>

          <select id="tech-filter" name="technology">
            <option value="all">All technologies</option>

            {technologies.map((technology) => (
              <option value={technology}>{technology}</option>
            ))}
          </select>
        </div>

        <div class="filter-field">
          <label for="status-filter">Status</label>

          <select id="status-filter" name="status">
            <option value="all">All statuses</option>

            {statuses.map((status) => (
              <option value={status}>{statusLabel[status]}</option>
            ))}
          </select>
        </div>

        <div class="filter-field">
          <label for="sort-filter">Sort by</label>

          <select id="sort-filter" name="sort">
            <option value="updated-desc">Recently updated</option>
            <option value="updated-asc">Oldest update</option>
            <option value="title-asc">Title, A to Z</option>
            <option value="title-desc">Title, Z to A</option>
            <option value="status">Status</option>
          </select>
        </div>

        <button class="clear-filter" id="clear-filter" type="button" hidden>
          Clear filters
        </button>
      </div>

      <p class="filter-summary" id="filter-summary" aria-live="polite">
        Showing all {labs.length} labs, recently updated first.
      </p>
    </section>

    <div id="labs-content">
      {groupedLabs.map((group) => (
        <section
          class="lab-group"
          id={group.id}
          data-lab-group
          data-group={group.id}
          aria-labelledby={`${group.id}-heading`}
        >
          <div class="section-heading">
            <div>
              <p class="section-kicker">{group.title}</p>
              <h2>{group.description}</h2>
            </div>
          </div>

          <div class="grid" data-lab-grid>
            {group.experiments.map((experiment) => (
              <article
                class="card"
                data-lab-card
                data-group={experiment.group}
                data-tech={experiment.tech.join("|").toLowerCase()}
                data-status={experiment.status}
                data-updated={experiment.updated}
                data-title={experiment.title.toLowerCase()}
                data-status-order={statusOrder[experiment.status]}
              >
                <div class="card-top">
                  <h3>{experiment.title}</h3>

                  <span
                    class:list={[
                      "status",
                      `status-${experiment.status}`,
                    ]}
                  >
                    {statusLabel[experiment.status]}
                  </span>
                </div>

                <p class="desc">{experiment.description}</p>

                <ul class="tech" aria-label="Technologies used">
                  {experiment.tech.map((technology) => (
                    <li>{technology}</li>
                  ))}
                </ul>

                <div class="card-links">
                  {experiment.demoUrl && (
                    <a
                      class="btn-primary"
                      href={experiment.demoUrl}
                      target="_blank"
                      rel="noopener"
                    >
                      Open lab <span aria-hidden="true">→</span>
                    </a>
                  )}

                  {experiment.repoUrl && (
                    <a
                      class="btn-secondary"
                      href={experiment.repoUrl}
                      target="_blank"
                      rel="noopener"
                    >
                      Source
                    </a>
                  )}
                </div>

                <p class="updated">
                  Updated <time datetime={experiment.updated}>{experiment.updated}</time>
                </p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="no-results" id="no-results" hidden role="status">
      No labs match those filters. Try changing a selection or clear the filters.
    </p>
  </main>

  <footer class="wrap footer">
    <a href="https://rjmlaird.co.uk">← Back to rjmlaird.co.uk</a>
  </footer>

  <script>
    const groupSelect =
      document.querySelector<HTMLSelectElement>("#group-filter");

    const technologySelect =
      document.querySelector<HTMLSelectElement>("#tech-filter");

    const statusSelect =
      document.querySelector<HTMLSelectElement>("#status-filter");

    const sortSelect =
      document.querySelector<HTMLSelectElement>("#sort-filter");

    const clearButton =
      document.querySelector<HTMLButtonElement>("#clear-filter");

    const summary =
      document.querySelector<HTMLElement>("#filter-summary");

    const noResults =
      document.querySelector<HTMLElement>("#no-results");

    const cards = [
      ...document.querySelectorAll<HTMLElement>("[data-lab-card]"),
    ];

    const groups = [
      ...document.querySelector<HTMLElement>("#labs-content")?.children ?? [],
    ];

    const getSelectedLabel = (
      select: HTMLSelectElement | null,
    ) => {
      if (!select) return "";

      return select.options[select.selectedIndex]?.text ?? "";
    };

    const sortCards = (
      cardList: HTMLElement[],
      sortValue: string,
    ) => {
      return [...cardList].sort((a, b) => {
        const aUpdated = a.dataset.updated ?? "";
        const bUpdated = b.dataset.updated ?? "";

        const aTitle = a.dataset.title ?? "";
        const bTitle = b.dataset.title ?? "";

        const aStatus = Number(a.dataset.statusOrder ?? "999");
        const bStatus = Number(b.dataset.statusOrder ?? "999");

        if (sortValue === "updated-asc") {
          return aUpdated.localeCompare(bUpdated);
        }

        if (sortValue === "title-asc") {
          return aTitle.localeCompare(bTitle);
        }

        if (sortValue === "title-desc") {
          return bTitle.localeCompare(aTitle);
        }

        if (sortValue === "status") {
          return aStatus - bStatus || bUpdated.localeCompare(aUpdated);
        }

        return bUpdated.localeCompare(aUpdated);
      });
    };

    const reorderVisibleCards = (sortValue: string) => {
      groups.forEach((group) => {
        const grid = group.querySelector<HTMLElement>("[data-lab-grid]");

        if (!grid) return;

        const visibleCards = [
          ...grid.querySelectorAll<HTMLElement>("[data-lab-card]"),
        ].filter((card) => !card.hidden);

        const sortedCards = sortCards(visibleCards, sortValue);

        sortedCards.forEach((card) => {
          grid.append(card);
        });
      });
    };

    const updateFilter = () => {
      if (
        !groupSelect ||
        !technologySelect ||
        !statusSelect ||
        !sortSelect ||
        !clearButton ||
        !summary ||
        !noResults
      ) {
        return;
      }

      const selectedGroup = groupSelect.value;
      const selectedTechnology = technologySelect.value.toLowerCase();
      const selectedStatus = statusSelect.value;
      const selectedSort = sortSelect.value;

      const groupIsFiltered = selectedGroup !== "all";
      const technologyIsFiltered = selectedTechnology !== "all";
      const statusIsFiltered = selectedStatus !== "all";

      let visibleCount = 0;

      cards.forEach((card) => {
        const cardGroup = card.dataset.group ?? "";
        const cardTechnologies = (card.dataset.tech ?? "").split("|");
        const cardStatus = card.dataset.status ?? "";

        const groupMatches =
          !groupIsFiltered ||
          cardGroup === selectedGroup;

        const technologyMatches =
          !technologyIsFiltered ||
          cardTechnologies.includes(selectedTechnology);

        const statusMatches =
          !statusIsFiltered ||
          cardStatus === selectedStatus;

        const matches =
          groupMatches &&
          technologyMatches &&
          statusMatches;

        card.hidden = !matches;

        if (matches) {
          visibleCount += 1;
        }
      });

      groups.forEach((group) => {
        const groupCards = [
          ...group.querySelectorAll<HTMLElement>("[data-lab-card]"),
        ];

        group.hidden = !groupCards.some((card) => !card.hidden);
      });

      reorderVisibleCards(selectedSort);

      const hasFilters =
        groupIsFiltered ||
        technologyIsFiltered ||
        statusIsFiltered;

      clearButton.hidden = !hasFilters;
      noResults.hidden = visibleCount !== 0;

      const filterLabels: string[] = [];

      if (groupIsFiltered) {
        filterLabels.push(getSelectedLabel(groupSelect));
      }

      if (technologyIsFiltered) {
        filterLabels.push(getSelectedLabel(technologySelect));
      }

      if (statusIsFiltered) {
        filterLabels.push(getSelectedLabel(statusSelect));
      }

      const sortLabel = getSelectedLabel(sortSelect);

      if (!hasFilters) {
        summary.textContent =
          `Showing all ${cards.length} labs, ${sortLabel.toLowerCase()}.`;
        return;
      }

      const filterText = filterLabels.join(" · ");

      summary.textContent =
        visibleCount === 1
          ? `Showing 1 lab matching ${filterText}, ${sortLabel.toLowerCase()}.`
          : `Showing ${visibleCount} labs matching ${filterText}, ${sortLabel.toLowerCase()}.`;
    };

    groupSelect?.addEventListener("change", updateFilter);
    technologySelect?.addEventListener("change", updateFilter);
    statusSelect?.addEventListener("change", updateFilter);
    sortSelect?.addEventListener("change", updateFilter);

    clearButton?.addEventListener("click", () => {
      if (
        !groupSelect ||
        !technologySelect ||
        !statusSelect ||
        !sortSelect
      ) {
        return;
      }

      groupSelect.value = "all";
      technologySelect.value = "all";
      statusSelect.value = "all";
      sortSelect.value = "updated-desc";

      updateFilter();
      groupSelect.focus();
    });

    updateFilter();
  </script>

  <style>
    .hero {
      position: relative;
      padding-top: clamp(4.5rem, 10vw, 6.5rem);
      padding-bottom: 3.5rem;
    }

    .orbit-line {
      position: absolute;
      top: 2.25rem;
      left: 0;
      width: 64px;
      height: 64px;
      border: 1px solid var(--teal);
      border-radius: 50%;
      opacity: 0.35;
    }

    .orbit-line::after {
      position: absolute;
      top: -3px;
      right: 6px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--amber);
      content: "";
    }

    .eyebrow,
    .section-kicker {
      margin-bottom: 0.75rem;
      color: var(--teal);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .hero h1 {
      max-width: 20ch;
      margin-bottom: 1.125rem;
      font-size: clamp(2rem, 4.5vw, 3rem);
      line-height: 1.08;
    }

    .sub {
      max-width: 64ch;
      margin-bottom: 0;
      color: var(--text-lo);
      font-size: 1rem;
      line-height: 1.65;
    }

    .filters {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 1.75rem 2.5rem;
      align-items: end;
      padding: 2.25rem 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .filter-intro h2 {
      margin-bottom: 0.55rem;
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    }

    .filter-intro > p:last-child {
      max-width: 42ch;
      margin-bottom: 0;
      color: var(--text-lo);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .filter-controls {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
      align-items: end;
    }

    .filter-field {
      display: grid;
      gap: 0.45rem;
    }

    .filter-field label {
      color: var(--text-lo);
      font-size: 0.8rem;
      font-weight: 500;
    }

    .filter-field select {
      width: 100%;
      min-height: 2.8rem;
      padding: 0.55rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--navy-raised);
      color: var(--text-hi);
    }

    .filter-field select:hover {
      border-color: rgba(0, 194, 168, 0.45);
    }

    .clear-filter {
      grid-column: 1 / -1;
      justify-self: start;
      padding: 0.35rem 0;
      border: 0;
      border-bottom: 1px solid transparent;
      border-radius: 0;
      background: transparent;
      color: var(--text-lo);
      font-size: 0.85rem;
      cursor: pointer;
    }

    .clear-filter:hover,
    .clear-filter:focus-visible {
      border-bottom-color: var(--teal);
      color: var(--text-hi);
    }

    .filter-summary {
      grid-column: 1 / -1;
      margin: 0;
      color: var(--text-lo);
      font-size: 0.85rem;
      line-height: 1.5;
    }

    .lab-group {
      padding-top: 3.5rem;
      scroll-margin-top: 1.5rem;
    }

    .lab-group:last-child {
      padding-bottom: 1.5rem;
    }

    .section-heading {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(240px, 0.7fr);
      gap: 1.5rem 2rem;
      align-items: end;
      margin-bottom: 1.5rem;
    }

    .section-heading h2 {
      font-size: clamp(1.45rem, 3vw, 1.9rem);
      line-height: 1.15;
    }

    .section-heading > p {
      max-width: 48ch;
      margin-bottom: 0;
      color: var(--text-lo);
      font-size: 0.92rem;
      line-height: 1.6;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    .card {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      min-height: 100%;
      padding: 1.5rem;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--navy-raised);
    }

    .card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .card-top h3 {
      font-size: 1.12rem;
      line-height: 1.25;
    }

    .status {
      flex: 0 0 auto;
      padding: 0.25rem 0.5rem;
      border: 1px solid currentColor;
      border-radius: 999px;
      font-family: var(--font-display);
      font-size: 0.67rem;
      font-weight: 500;
      letter-spacing: 0.07em;
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .status-active {
      color: var(--teal);
    }

    .status-in-progress {
      color: var(--amber);
    }

    .status-planned {
      color: #cfb879;
    }

    .status-archived {
      color: var(--text-lo);
    }

    .desc {
      margin-bottom: 0;
      color: var(--text-lo);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0;
      padding: 0;
      list-style: none;
    }

    .tech li {
      padding: 0.2rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text-lo);
      font-size: 0.75rem;
      line-height: 1.2;
    }

    .card-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: auto;
      padding-top: 0.35rem;
    }

    .btn-primary,
    .btn-secondary {
      padding: 0.5rem 0.8rem;
      border-radius: 8px;
      font-family: var(--font-display);
      font-size: 0.84rem;
      line-height: 1.2;
      text-decoration: none;
    }

    .btn-primary {
      background: var(--teal);
      color: var(--navy);
      font-weight: 600;
    }

    .btn-primary:hover,
    .btn-primary:focus-visible {
      background: var(--teal-hover);
    }

    .btn-secondary {
      border: 1px solid var(--border);
      color: var(--text-lo);
    }

    .btn-secondary:hover,
    .btn-secondary:focus-visible {
      border-color: var(--text-lo);
      color: var(--text-hi);
    }

    .updated {
      margin-bottom: 0;
      color: var(--text-lo);
      font-size: 0.75rem;
      line-height: 1.4;
    }

    .no-results {
      margin: 3rem 0;
      padding: 1rem 1.25rem;
      border: 1px dashed var(--border);
      border-radius: 10px;
      color: var(--text-lo);
      line-height: 1.55;
    }

    .footer {
      margin-top: 3rem;
      padding-top: 2rem;
      padding-bottom: 4rem;
      border-top: 1px solid var(--border);
    }

    .footer a {
      color: var(--text-lo);
      font-size: 0.9rem;
      text-decoration: none;
    }

    .footer a:hover,
    .footer a:focus-visible {
      color: var(--text-hi);
    }

    @media (max-width: 760px) {
      .filters,
      .section-heading {
        grid-template-columns: 1fr;
      }

      .filters {
        gap: 1.5rem;
      }

      .filter-controls {
        max-width: 38rem;
      }

      .lab-group {
        padding-top: 2.75rem;
      }
    }

    @media (max-width: 520px) {
      .hero {
        padding-top: 4.5rem;
        padding-bottom: 2.75rem;
      }

      .filters {
        padding: 1.5rem 0;
      }

      .filter-controls {
        grid-template-columns: 1fr;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .card {
        padding: 1.25rem;
      }

      .card-top {
        flex-direction: column;
      }
    }
  </style>
</Base>
