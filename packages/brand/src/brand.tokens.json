{
  "$description": "rjmlaird brand tokens (DTCG 2021 draft). Source of truth for labs.rjmlaird.co.uk. Dark values are taken verbatim from rjmlaird.co.uk global.css so labs and the main site cannot drift. Replace this file with the published tokens from brand.rjmlaird.co.uk once that package exists; the build script only needs the same shape.",
  "theme": {
    "dark": {
      "ink": {
        "$type": "color",
        "$value": "#0B0F1A",
        "$description": "page background"
      },
      "ink-2": {
        "$type": "color",
        "$value": "#0F1520",
        "$description": "inset / sunken surface"
