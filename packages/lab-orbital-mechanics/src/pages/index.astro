---
import Layout from '../layouts/Layout.astro';
import { presets } from '../lib/presets';
---

<Layout
  title="N-Body Gravity — labs.rjmlaird.co.uk"
  description="An interactive N-body gravitational simulation in real astronomical units: place bodies by solar mass and AU distance, and watch Kepler's three laws play out live."
>
  <main class="relative h-[100dvh] w-full overflow-hidden">
    <canvas id="sim-canvas" class="absolute inset-0 h-full w-full cursor-crosshair"></canvas>

    <!-- Eyebrow / title, top-left -->
    <div class="pointer-events-none absolute left-4 top-4 sm:left-6 sm:top-6 max-w-sm">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-teal">Lab 01 — Orbital Mechanics</p>
      <h1 class="mt-1 font-display text-2xl sm:text-3xl font-semibold leading-tight">N-Body Gravity Simulator</h1>
      <p class="mt-2 hidden sm:block text-sm text-white/60 leading-relaxed">
        Real masses in solar masses (M&#9737;), real distances in AU. Load a preset, add bodies by
        mass and orbital distance, or click-drag on the canvas for a quick freehand launch.
      </p>
    </div>

    <!-- Stats + Kepler panel, top-right -->
    <div
      id="stats-panel"
      class="absolute right-4 top-4 sm:right-6 sm:top-6 w-72 max-w-[85vw] rounded-lg border border-white/10 bg-navy-light/90 backdrop-blur-sm"
    >
      <button
        id="stats-toggle"
        type="button"
        class="flex w-full items-center justify-between gap-2 px-4 py-2 font-mono text-[10px] uppercase tracking-[0.15em] text-white/40 transition hover:text-white/70"
      >
        <span>Status</span>
        <span id="stats-toggle-icon">&#9662;</span>
      </button>

      <div id="stats-content">
        <div class="px-4 pb-3 font-mono text-xs">
          <div class="flex items-center justify-between gap-6">
            <span class="text-white/50">SYSTEM</span>
            <span id="stat-preset" class="text-white text-right">Kepler's laws</span>
          </div>
          <div class="mt-1 flex items-center justify-between gap-6">
            <span class="text-white/50">BODIES</span>
            <span id="stat-bodies" class="text-teal">0</span>
          </div>
          <div class="mt-1 flex items-center justify-between gap-6">
            <span class="text-white/50">ENERGY&nbsp;&Delta;</span>
            <span id="stat-energy" class="text-amber">0.00%</span>
          </div>
          <div class="mt-1 flex items-center justify-between gap-6">
            <span class="text-white/50">UNITS</span>
            <span id="stat-units" class="text-white/70 text-right">M&#9737; · AU · yr</span>
          </div>
        </div>

      <div id="kepler-panel" class="hidden border-t border-white/10 px-4 py-3">
        <p class="font-display text-sm font-semibold text-white">Kepler's laws, live</p>

        <div class="mt-2 font-mono text-[11px] leading-relaxed text-white/60">
          <p><span class="text-amber">&#9737;</span> Focus (dashed ring) — <span id="kepler-focus">–</span></p>
          <p class="mt-0.5">Sweep target — <span id="kepler-target">–</span></p>
        </div>

        <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">
          2nd law — area swept per equal interval (AU&sup2;)
        </p>
        <div id="kepler-areas" class="mt-1 flex flex-wrap gap-1 font-mono text-[11px] text-teal"></div>
        <p class="mt-1 text-[10px] leading-snug text-white/40">
          Values should stay close together — equal areas in equal times, however fast or slow the body is moving.
        </p>

        <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">
          3rd law — T&sup2; &prop; a&sup3;
        </p>
        <table class="mt-1 w-full font-mono text-[11px]">
          <thead>
            <tr class="text-white/40">
              <th class="text-left font-normal">Body</th>
              <th class="text-right font-normal">a (AU)</th>
              <th class="text-right font-normal">T (yr)</th>
              <th class="text-right font-normal">T&sup2;/a&sup3;</th>
            </tr>
          </thead>
          <tbody id="kepler-table"></tbody>
        </table>
        <p id="kepler-expected" class="mt-1 text-[10px] leading-snug text-white/40"></p>
      </div>
      </div>
    </div>

    <!-- Control panel, bottom -->
    <div
      id="controls-panel"
      class="absolute bottom-0 left-0 right-0 border-t border-white/10 bg-navy-light/90 backdrop-blur-md"
    >
      <button
        id="controls-toggle"
        type="button"
        class="flex w-full items-center justify-center gap-2 py-1.5 font-mono text-[10px] uppercase tracking-[0.15em] text-white/40 transition hover:text-white/70"
      >
        <span id="controls-toggle-icon">&#9662;</span>
        <span id="controls-toggle-label">Hide controls</span>
      </button>

      <div id="controls-content" class="hud-scroll max-h-[55dvh] overflow-y-auto sm:max-h-[60dvh]">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 pb-4 sm:px-6">
        <!-- Presets -->
        <div>
          <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Presets</p>
          <div class="flex flex-wrap gap-2" id="preset-buttons">
            {
              presets.map((p) => (
                <button
                  type="button"
                  data-preset={p.id}
                  title={p.description}
                  class="preset-btn rounded-md border border-white/10 bg-navy px-3 py-1.5 font-display text-sm font-medium text-white/80 transition hover:border-teal/50 hover:text-white"
                >
                  {p.label}
                </button>
              ))
            }
          </div>
          <p id="preset-description" class="mt-2 max-w-2xl text-xs leading-relaxed text-white/50"></p>
        </div>

        <!-- Add body by mass + distance -->
        <div class="rounded-md border border-white/10 bg-navy/60 p-3">
          <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">
            Add body — by mass &amp; orbital distance
          </p>
          <div class="flex flex-wrap items-end gap-x-6 gap-y-3">
            <label class="flex flex-col gap-1">
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Mass (M&#9737;)</span>
              <input
                id="add-mass"
                type="number"
                step="any"
                min="0"
                value="0.000003"
                class="w-32 rounded border border-white/15 bg-navy px-2 py-1 font-mono text-sm text-white"
              />
            </label>

            <label class="flex flex-col gap-1">
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Orbit around</span>
              <select
                id="add-central"
                class="w-44 rounded border border-white/15 bg-navy px-2 py-1 font-mono text-sm text-white"
              >
                <option value="">None (place at rest)</option>
              </select>
            </label>

            <label class="flex flex-col gap-1">
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Semi-major axis a (AU)</span>
              <input
                id="add-a"
                type="number"
                step="any"
                min="0.01"
                value="2"
                class="w-28 rounded border border-white/15 bg-navy px-2 py-1 font-mono text-sm text-white"
              />
            </label>

            <label class="flex flex-col gap-1">
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Eccentricity e</span>
              <input
                id="add-e"
                type="number"
                step="0.01"
                min="0"
                max="0.95"
                value="0"
                class="w-24 rounded border border-white/15 bg-navy px-2 py-1 font-mono text-sm text-white"
              />
            </label>

            <label class="flex items-center gap-2 font-mono text-xs text-white/60">
              <input id="add-retrograde" type="checkbox" class="accent-teal" />
              Retrograde
            </label>

            <button
              id="add-body-btn"
              type="button"
              class="rounded-md bg-teal px-4 py-2 font-display text-sm font-semibold text-navy transition hover:bg-teal-dim"
            >
              Launch orbit
            </button>
          </div>
          <p class="mt-2 text-[11px] leading-relaxed text-white/40">
            With a body selected under "Orbit around", the new body is placed at periapsis (its closest
            approach) and given the exact Keplerian velocity for that mass, distance, and eccentricity —
            real vis-viva orbital mechanics, not an approximation.
          </p>
        </div>

        <!-- Sliders + toggles -->
        <div class="flex flex-wrap items-end gap-x-8 gap-y-3">
          <label class="flex flex-col gap-1">
            <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Gravity strength (&times;)</span>
            <input id="g-slider" type="range" min="0.1" max="3" step="0.05" value="1" class="w-36 accent-teal" />
          </label>

          <label class="flex flex-col gap-1">
            <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Softening (&times;)</span>
            <input id="softening-slider" type="range" min="0.2" max="5" step="0.1" value="1" class="w-36 accent-teal" />
          </label>

          <label class="flex flex-col gap-1">
            <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Zoom (px / AU)</span>
            <input id="zoom-slider" type="range" min="5" max="300" step="1" value="90" class="w-36 accent-teal" />
          </label>

          <label class="flex flex-col gap-1">
            <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-white/40">Simulation speed</span>
            <input id="speed-slider" type="range" min="1" max="30" step="1" value="6" class="w-36 accent-teal" />
          </label>

          <div class="flex flex-wrap items-center gap-2">
            <button
              id="play-pause"
              type="button"
              class="rounded-md bg-teal px-4 py-2 font-display text-sm font-semibold text-navy transition hover:bg-teal-dim"
            >
              Pause
            </button>
            <button
              id="reset-btn"
              type="button"
              class="rounded-md border border-white/15 px-4 py-2 font-display text-sm font-medium text-white/80 transition hover:border-white/30"
            >
              Reset
            </button>
            <button
              id="clear-btn"
              type="button"
              class="rounded-md border border-white/15 px-4 py-2 font-display text-sm font-medium text-white/80 transition hover:border-white/30"
            >
              Clear
            </button>
            <label class="ml-2 flex items-center gap-2 font-mono text-xs text-white/60">
              <input id="trails-toggle" type="checkbox" checked class="accent-teal" />
              Trails
            </label>
            <label class="flex items-center gap-2 font-mono text-xs text-white/60">
              <input id="kepler-toggle" type="checkbox" class="accent-amber" />
              Kepler's laws overlay
            </label>
          </div>
        </div>
      </div>
      </div>
    </div>
  </main>

  <script>
    import { Simulation, type OrbitalRow } from '../lib/simulation';
    import { presets, getPreset } from '../lib/presets';

    const canvas = document.getElementById('sim-canvas') as HTMLCanvasElement;
    const sim = new Simulation(canvas);

    const controlsToggle = document.getElementById('controls-toggle') as HTMLButtonElement;
    const controlsContent = document.getElementById('controls-content') as HTMLElement;
    const controlsIcon = document.getElementById('controls-toggle-icon')!;
    const controlsLabel = document.getElementById('controls-toggle-label')!;
    const statsToggle = document.getElementById('stats-toggle') as HTMLButtonElement;
    const statsContent = document.getElementById('stats-content') as HTMLElement;
    const statsToggleIcon = document.getElementById('stats-toggle-icon')!;

    function setPanelCollapsed(
      collapsed: boolean,
      content: HTMLElement,
      icon: HTMLElement,
      storageKey: string,
      label?: HTMLElement
    ) {
      content.style.display = collapsed ? 'none' : '';
      icon.innerHTML = collapsed ? '&#9656;' : '&#9662;';
      if (label) label.textContent = collapsed ? 'Show controls' : 'Hide controls';
      try {
        localStorage.setItem(storageKey, collapsed ? '1' : '0');
      } catch {
        // localStorage unavailable (private browsing etc.) — not critical, state just won't persist
      }
    }

    let controlsCollapsed = true; // start collapsed so the canvas is unobstructed on load
    let statsCollapsed = false;
    try {
      controlsCollapsed = localStorage.getItem('labs-controls-collapsed') !== '0';
      statsCollapsed = localStorage.getItem('labs-stats-collapsed') === '1';
    } catch {
      // ignore
    }
    setPanelCollapsed(controlsCollapsed, controlsContent, controlsIcon, 'labs-controls-collapsed', controlsLabel);
    setPanelCollapsed(statsCollapsed, statsContent, statsToggleIcon, 'labs-stats-collapsed');

    controlsToggle.addEventListener('click', () => {
      controlsCollapsed = !controlsCollapsed;
      setPanelCollapsed(controlsCollapsed, controlsContent, controlsIcon, 'labs-controls-collapsed', controlsLabel);
    });
    statsToggle.addEventListener('click', () => {
      statsCollapsed = !statsCollapsed;
      setPanelCollapsed(statsCollapsed, statsContent, statsToggleIcon, 'labs-stats-collapsed');
    });

    const statBodies = document.getElementById('stat-bodies')!;
    const statEnergy = document.getElementById('stat-energy')!;
    const statPreset = document.getElementById('stat-preset')!;
    const statUnits = document.getElementById('stat-units')!;
    const presetDescription = document.getElementById('preset-description')!;
    const playPauseBtn = document.getElementById('play-pause') as HTMLButtonElement;
    const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
    const trailsToggle = document.getElementById('trails-toggle') as HTMLInputElement;
    const keplerToggle = document.getElementById('kepler-toggle') as HTMLInputElement;
    const keplerPanel = document.getElementById('kepler-panel')!;
    const keplerFocus = document.getElementById('kepler-focus')!;
    const keplerTarget = document.getElementById('kepler-target')!;
    const keplerAreas = document.getElementById('kepler-areas')!;
    const keplerTable = document.getElementById('kepler-table')!;
    const keplerExpected = document.getElementById('kepler-expected')!;
    const gSlider = document.getElementById('g-slider') as HTMLInputElement;
    const softeningSlider = document.getElementById('softening-slider') as HTMLInputElement;
    const zoomSlider = document.getElementById('zoom-slider') as HTMLInputElement;
    const speedSlider = document.getElementById('speed-slider') as HTMLInputElement;
    const presetButtons = document.querySelectorAll<HTMLButtonElement>('.preset-btn');

    const addMass = document.getElementById('add-mass') as HTMLInputElement;
    const addCentral = document.getElementById('add-central') as HTMLSelectElement;
    const addA = document.getElementById('add-a') as HTMLInputElement;
    const addE = document.getElementById('add-e') as HTMLInputElement;
    const addRetrograde = document.getElementById('add-retrograde') as HTMLInputElement;
    const addBodyBtn = document.getElementById('add-body-btn') as HTMLButtonElement;

    let baseG = 1;
    let baseSoftening = 1;

    function refreshCentralOptions() {
      const bodies = sim.listBodies();
      const previous = addCentral.value;
      addCentral.innerHTML = '<option value="">None (place at rest)</option>';
      for (const b of bodies) {
        const opt = document.createElement('option');
        opt.value = String(b.id);
        opt.textContent = `${b.label}`;
        addCentral.appendChild(opt);
      }
      if (bodies.some((b) => String(b.id) === previous)) addCentral.value = previous;
    }

    function setActivePreset(id: string) {
      presetButtons.forEach((btn) => {
        const isActive = btn.dataset.preset === id;
        btn.classList.toggle('border-teal', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('bg-navy-lighter', isActive);
      });
      const preset = getPreset(id);
      presetDescription.textContent = preset.description;
      statUnits.textContent = preset.unit === 'astro' ? 'M\u2609 · AU · yr' : 'normalised sim units';
      baseG = preset.config.G ?? 1;
      baseSoftening = preset.config.softening ?? 1;
      gSlider.value = '1';
      softeningSlider.value = '1';
      zoomSlider.value = String(preset.pixelsPerAU);
      keplerToggle.checked = !!preset.keplerDemo;
      keplerPanel.classList.toggle('hidden', !preset.keplerDemo);
    }

    function loadAndActivate(id: string) {
      sim.loadPresetById(id);
      setActivePreset(id);
      playPauseBtn.textContent = 'Pause';
      sim.setRunning(true);
      refreshCentralOptions();
    }

    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => loadAndActivate(btn.dataset.preset!));
    });

    playPauseBtn.addEventListener('click', () => {
      const running = sim.toggleRunning();
      playPauseBtn.textContent = running ? 'Pause' : 'Play';
    });

    resetBtn.addEventListener('click', () => {
      sim.reset();
      sim.setRunning(true);
      playPauseBtn.textContent = 'Pause';
      refreshCentralOptions();
    });

    clearBtn.addEventListener('click', () => {
      sim.clear();
      refreshCentralOptions();
    });

    trailsToggle.addEventListener('change', () => sim.setTrails(trailsToggle.checked));

    keplerToggle.addEventListener('change', () => {
      sim.setKeplerEnabled(keplerToggle.checked);
      keplerPanel.classList.toggle('hidden', !keplerToggle.checked);
    });

    gSlider.addEventListener('input', () => sim.setG(baseG * parseFloat(gSlider.value)));
    softeningSlider.addEventListener('input', () => sim.setSoftening(baseSoftening * parseFloat(softeningSlider.value)));
    zoomSlider.addEventListener('input', () => sim.setZoom(parseFloat(zoomSlider.value)));
    speedSlider.addEventListener('input', () => sim.setSpeed(parseInt(speedSlider.value, 10)));

    addBodyBtn.addEventListener('click', () => {
      const mass = parseFloat(addMass.value);
      const a = parseFloat(addA.value);
      const e = Math.min(0.95, Math.max(0, parseFloat(addE.value)));
      const centralRaw = addCentral.value;
      if (!isFinite(mass) || mass <= 0 || !isFinite(a) || a <= 0) return;
      sim.addOrbitingBody({
        mass,
        aroundBodyId: centralRaw ? parseInt(centralRaw, 10) : null,
        a,
        e,
        retrograde: addRetrograde.checked,
      });
      refreshCentralOptions();
    });

    sim.onStatsUpdate(({ bodyCount, energyDrift, presetLabel }) => {
      statBodies.textContent = String(bodyCount);
      statEnergy.textContent = `${energyDrift >= 0 ? '+' : ''}${energyDrift.toFixed(2)}%`;
      statPreset.textContent = presetLabel;
    });

    function fmt(n: number, digits = 3): string {
      if (!isFinite(n)) return '—';
      if (Math.abs(n) < 0.0005 && n !== 0) return n.toExponential(2);
      return n.toFixed(digits);
    }

    sim.onKeplerUpdate(({ enabled, focusLabel, targetLabel, wedgeAreas, table, expectedRatio }) => {
      if (!enabled) return;
      keplerFocus.textContent = focusLabel ?? '–';
      keplerTarget.textContent = targetLabel ?? '–';

      keplerAreas.innerHTML = '';
      wedgeAreas.forEach((a) => {
        const span = document.createElement('span');
        span.className = 'rounded bg-navy px-1.5 py-0.5 border border-white/10';
        span.textContent = fmt(a, 4);
        keplerAreas.appendChild(span);
      });

      keplerTable.innerHTML = '';
      (table as OrbitalRow[]).forEach((row) => {
        const tr = document.createElement('tr');
        tr.className = 'text-white/80';
        tr.innerHTML = `
          <td class="py-0.5">${row.label}</td>
          <td class="py-0.5 text-right">${row.bound ? fmt(row.a) : '—'}</td>
          <td class="py-0.5 text-right">${row.bound ? fmt(row.T) : '—'}</td>
          <td class="py-0.5 text-right ${row.bound ? 'text-teal' : ''}">${row.bound ? fmt(row.ratio, 3) : 'unbound'}</td>
        `;
        keplerTable.appendChild(tr);
      });

      keplerExpected.textContent =
        expectedRatio !== null
          ? `Expected T\u00B2/a\u00B3 = 1/M_focus = ${fmt(expectedRatio, 3)} \u2014 every bound body above should match.`
          : '';
    });

    // Boot with the Kepler's laws demo
    loadAndActivate('keplers-laws');
    sim.start();
  </script>
</Layout>
