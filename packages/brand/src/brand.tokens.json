  "viz": {
    "$description": "Categorical chart palette, in order of use. Always pair colour with a second encoding (shape, label, dash).",
    "order": [
      "teal",
      "amber",
      "violet",
      "sky",
      "coral",
      "green",
      "text-2",
      "watch"
    ]
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Space Grotesk Variable",
        "Space Grotesk",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter Variable",
        "Inter",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono Variable",
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ]
    }
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "pill": "999px"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem"
  },
  "layout": {
    "content-max": "1320px",
    "nav-h": "3.25rem",
    "gutter-min": "clamp(1rem, 4vw, 2rem)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(.2,.7,.2,1)"
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "md": "1.125rem",
    "lg": "1.25rem",
    "xl": "clamp(1.45rem, 2.4vw, 1.8rem)",
    "2xl": "clamp(1.9rem, 4vw, 2.7rem)",
    "leading": "1.6",
    "leading-tight": "1.15"
  }
}
