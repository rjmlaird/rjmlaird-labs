---
import { getCollection } from 'astro:content';

const cases = await getCollection('cases');
const { currentSlug } = Astro.props;
const sorted = [...cases].sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<aside class="sidebar card pad">
  <div class="sidebar-head">
    <span class="pill">Case studies</span>
    <h2>Navigation</h2>
    <p>Browse wildfire case studies.</p>
  </div>

  <nav aria-label="Case study navigation" class="sidebar-nav">
    {sorted.map((entry) => {
      const active = currentSlug === entry.data.slug;
      return (
        <a
          href={`/case/${entry.data.slug}/`}
          class:list={['sidebar-link', { active }]}
          aria-current={active ? 'page' : undefined}
        >
          <strong>{entry.data.title}</strong>
          <span>{entry.data.region}</span>
        </a>
      );
    })}
  </nav>

  <style>
    .sidebar-head { display: grid; gap: 10px; margin-bottom: 14px; }
    .sidebar-head h2 { margin: 0; font-size: 1.1rem; }
    .sidebar-head p { margin: 0; color: #9eb2c9; }
    .sidebar-nav { display: grid; gap: 10px; }
    .sidebar-link {
      display: grid;
      gap: 4px;
      padding: 12px 14px;
      border-radius: 12px;
      background: #0d1622;
      border: 1px solid #24364a;
      color: #e8eef7;
      text-decoration: none;
    }
    .sidebar-link span { color: #9eb2c9; font-size: 0.9rem; }
    .sidebar-link.active { border-color: #5f8cc0; background: #122338; }
    @media (min-width: 900px) { .sidebar { position: sticky; top: 16px; } }
  </style>
</aside>
