{
  "name": "physics",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./apps/hub/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "physics.labs.rjmlaird.co.uk",
      "custom_domain": true
    }
  ]
}
