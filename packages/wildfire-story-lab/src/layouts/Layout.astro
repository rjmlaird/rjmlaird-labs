---
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: #09111a;
        color: #e8eef7;
      }
      .shell {
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px;
      }
      .page {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        align-items: start;
      }
      .content { display: grid; gap: 16px; }
      .card {
        background: #101a27;
        border: 1px solid #203247;
        border-radius: 18px;
        overflow: hidden;
      }
      .pad { padding: 16px; }
      .pill {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 999px;
        background: #16314d;
        color: #cfe3ff;
        font-size: 0.875rem;
      }
      h1 {
        margin: 0 0 8px;
        font-size: clamp(2rem, 4vw, 3.5rem);
        line-height: 1.05;
      }
      p {
        margin: 0;
        line-height: 1.6;
        color: #b8c6d9;
      }
      .pixel-tooltip {
        position: fixed;
        z-index: 50;
        pointer-events: none;
        padding: 8px 10px;
        border-radius: 10px;
        background: rgba(11, 17, 24, 0.95);
        border: 1px solid #24364a;
        color: #eef5ff;
        box-shadow: 0 12px 24px rgba(0,0,0,.24);
        font-size: 0.88rem;
      }
      @media (min-width: 900px) {
        .page { grid-template-columns: 280px minmax(0, 1fr); gap: 24px; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <slot />
    </div>
  </body>
</html>
