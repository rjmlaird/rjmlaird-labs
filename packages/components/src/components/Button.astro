---
interface Props {
  variant?: "primary" | "secondary";
}
const { variant = "primary" } = Astro.props;
---
<button class={`btn btn-${variant}`}><slot /></button>

<style>
  .btn {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 0.9rem;
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
  }
  .btn:focus-visible {
    outline: 2px solid #00c2a8;
    outline-offset: 2px;
  }
  .btn-primary {
    background: #00c2a8;
    color: #0b0f1a;
    font-weight: 600;
  }
  .btn-secondary {
    background: transparent;
    color: #eef2f6;
    border: 1px solid rgba(238, 242, 246, 0.15);
  }
</style>
