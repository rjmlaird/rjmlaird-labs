{
  "name": "component-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared, tested interface components for the R. J. M. Laird sites.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --config-dir .storybook",
    "build": "storybook build --config-dir .storybook",
    "typecheck": "tsc --noEmit",
    "test:a11y": "playwright test",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "http-server": "^14.1.1",
    "storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@12.8.1"
}
