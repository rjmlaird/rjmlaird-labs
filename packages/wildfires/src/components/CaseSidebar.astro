---
import { getCollection } from 'astro:content';

const cases = await getCollection('cases');
const { currentSlug } = Astro.props;
const sorted = [...cases].sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<aside class="sidebar card pad">
  <div class="sidebar-head">
    <span class="pill">Case studies</span>
    <h2>Browse fires</h2>
    <p>Before-and-after satellite pairs, from ignition to early recovery.</p>
  </div>

  <nav aria-label="Case study navigation" class="sidebar-nav">
    {sorted.map((entry) => {
      const active = currentSlug === entry.data.slug;
      return (
        <a
          href={`/case/${entry.data.slug}/`}
          class:list={['sidebar-link', { active }]}
          aria-current={active ? 'page' : undefined}
        >
          <strong>{entry.data.title}</strong>
          <span>{entry.data.region} · {entry.data.sensor}</span>
        </a>
      );
    })}
  </nav>

  <style>
    .sidebar-head { display: grid; gap: 10px; margin-bottom: 16px; }
    .sidebar-head h2 { margin: 0; font-size: 1.15rem; }
    .sidebar-head p { margin: 0; color: var(--ink-faint); font-size: 0.9rem; }
    .sidebar-nav { display: grid; gap: 8px; }
    .sidebar-link {
      display: grid;
      gap: 4px;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      background: var(--bg-inset);
      border: 1px solid var(--line);
      color: var(--ink);
      text-decoration: none;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .sidebar-link:hover { border-color: var(--orbit); }
    .sidebar-link span { color: var(--ink-faint); font-size: 0.85rem; }
    .sidebar-link.active { border-color: var(--orbit); background: var(--orbit-dim); }
    .sidebar-link.active span { color: var(--ink-soft); }
    @media (min-width: 900px) { .sidebar { position: sticky; top: 16px; } }
  </style>
</aside>
