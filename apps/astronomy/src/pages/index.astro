---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LabCard from '../components/LabCard.astro';
import { categories } from '../data/categories';
const labs = (await getCollection('labs')).filter((l) => l.data.status !== 'planned')
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---
<Base title="Astronomy Labs">
  <h1>Astronomy Labs</h1>
  <p class="lede">Interactive demos for astronomy, space science and engineering by Ryan Laird.</p>
  {categories.map((c) => {
    const items = labs.filter((l) => l.data.category === c.id);
    return items.length ? (
      <section>
        <h2><a href={`/c/${c.id}/`} style="color:inherit;text-decoration:none">{c.icon} {c.title}</a></h2>
        <ul class="cards">{items.map((lab) => <LabCard lab={lab} />)}</ul>
      </section>
    ) : null;
  })}
</Base>
