---
import Base from "../layouts/Base.astro";
import experiments from "../data/experiments.json";

const statusLabel = {
  active: "in orbit",
  planned: "pre-launch",
  archived: "decayed"
};
---
<Base title="Labs">
  <header class="hero wrap">
    <div class="orbit-line" aria-hidden="true"></div>
    <p class="eyebrow">rjmlaird.co.uk / labs</p>
    <h1>Working experiments, not finished products.</h1>
    <p class="sub">
      A sandbox for orbital mechanics tools, data pipelines, and interface prototypes.
      Some of these will graduate to the main site. Most won't, and that's the point.
    </p>
  </header>

  <main class="wrap grid">
    {experiments.map((exp) => (
      <article class="card">
        <div class="card-top">
          <h2>{exp.title}</h2>
          <span class={`status status-${exp.status}`}>{statusLabel[exp.status] ?? exp.status}</span>
        </div>
        <p class="desc">{exp.description}</p>
        <ul class="tech">
          {exp.tech.map((t: string) => <li>{t}</li>)}
        </ul>
        <div class="card-links">
          {exp.demoUrl && <a class="btn-primary" href={exp.demoUrl} target="_blank" rel="noopener">Open demo →</a>}
          {exp.repoUrl && <a class="btn-secondary" href={exp.repoUrl} target="_blank" rel="noopener">Source</a>}
        </div>
        <p class="updated">Updated {exp.updated}</p>
      </article>
    ))}
  </main>

  <footer class="wrap footer">
    <a href="https://rjmlaird.co.uk">← Back to rjmlaird.co.uk</a>
  </footer>

  <style>
    .hero {
      padding: 5rem 1.5rem 3rem;
      position: relative;
    }
    .orbit-line {
      position: absolute;
      top: 2.5rem;
      left: 1.5rem;
      width: 64px;
      height: 64px;
      border: 1px solid var(--teal);
      border-radius: 50%;
      opacity: 0.35;
    }
    .orbit-line::after {
      content: "";
      position: absolute;
      top: -3px;
      right: 6px;
      width: 6px;
      height: 6px;
      background: var(--amber);
      border-radius: 50%;
    }
    .eyebrow {
      font-family: var(--font-display);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--teal);
      margin: 0 0 1rem;
    }
    h1 {
      font-size: clamp(1.9rem, 4vw, 2.6rem);
      max-width: 20ch;
      margin-bottom: 1rem;
    }
    .sub {
      color: var(--text-lo);
      max-width: 56ch;
      line-height: 1.6;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
      padding-bottom: 4rem;
    }

    .card {
      background: var(--navy-raised);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .card-top h2 {
      font-size: 1.1rem;
    }
    .status {
      font-family: var(--font-display);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      white-space: nowrap;
      border: 1px solid currentColor;
    }
    .status-active { color: var(--teal); }
    .status-planned { color: var(--amber); }
    .status-archived { color: var(--text-lo); }

    .desc {
      color: var(--text-lo);
      font-size: 0.9rem;
      line-height: 1.5;
      margin: 0;
    }
    .tech {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      padding: 0;
      margin: 0;
    }
    .tech li {
      font-size: 0.75rem;
      color: var(--text-lo);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.15rem 0.5rem;
    }
    .card-links {
      display: flex;
      gap: 0.75rem;
      margin-top: auto;
      padding-top: 0.5rem;
    }
    .btn-primary, .btn-secondary {
      font-size: 0.85rem;
      text-decoration: none;
      padding: 0.45rem 0.8rem;
      border-radius: 8px;
      font-family: var(--font-display);
    }
    .btn-primary {
      background: var(--teal);
      color: var(--navy);
      font-weight: 600;
    }
    .btn-secondary {
      color: var(--text-lo);
      border: 1px solid var(--border);
    }
    .updated {
      font-size: 0.75rem;
      color: var(--text-lo);
      margin: 0;
    }

    .footer {
      padding: 2rem 1.5rem 4rem;
      border-top: 1px solid var(--border);
    }
    .footer a {
      text-decoration: none;
      color: var(--text-lo);
      font-size: 0.9rem;
    }
  </style>
</Base>
