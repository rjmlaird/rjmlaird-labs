---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/Card.astro';
---

<Layout title="Mechanics Lab" current="index">
  <main class="page">
    <header class="hero">
      <p class="eyebrow">Labs</p>
      <h1>Mechanics Experiments</h1>
      <p class="lede">
        Four interactive classical-mechanics experiments, all built on the same physics engine: SUVAT equations,
        conservation of energy, and conservation of momentum, worked out live with the numbers you choose.
      </p>
    </header>

    <section class="page-notes card-grid">
      <Card
        eyebrow="Forces & friction"
        title="Ramp"
        href="/ramp"
        description="Static vs. kinetic friction, air resistance, and block-on-block collisions on an incline."
      />
      <Card
        eyebrow="Collisions"
        title="Newton's Cradle"
        href="/newtonscradle"
        description="Real pendulum physics — pull back one or two balls and watch momentum and energy transfer through the row."
      />
      <Card
        eyebrow="Kinematics"
        title="Projectile Motion"
        href="/projectile"
        description="Launch speed, angle, and height, with independent horizontal and vertical SUVAT equations."
      />
      <Card
        eyebrow="Real-world physics"
        title="Stopping Distances"
        href="/stoppingdistance"
        description="Reaction distance plus SUVAT-derived braking distance, across speeds and road conditions."
      />
    </section>
  </main>
</Layout>
