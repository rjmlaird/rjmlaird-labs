---
import Layout from '../layouts/Layout.astro';
import MechanicsLab from '../components/MechanicsLab';
---

<Layout
  title="Mechanics Lab"
  description="Explore motion, energy, friction, mass, momentum, and acceleration on a simple ramp."
>
  <main class="page">
    <header class="hero">
      <p class="eyebrow">Labs</p>
      <h1>Mechanics Lab</h1>
      <p class="lede">
        Explore motion, energy, friction, mass, momentum, and acceleration on a simple ramp.
      </p>
    </header>

    <MechanicsLab client:only="react" />
  </main>
</Layout>
