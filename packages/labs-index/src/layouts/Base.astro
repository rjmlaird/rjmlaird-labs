---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Experiments and prototypes from rjmlaird.co.uk." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · labs.rjmlaird.co.uk</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
