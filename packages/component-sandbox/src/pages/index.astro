---
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Callout from "../components/Callout.astro";

const entries = [
  {
    name: "Button",
    snippet: `<Button variant="primary">Save changes</Button>\n<Button variant="secondary">Cancel</Button>`
  },
  {
    name: "Card",
    snippet: `<Card title="Observation window">\n  Best visibility starts 22:40 local time.\n</Card>`
  },
  {
    name: "Callout",
    snippet: `<Callout tone="warning">\n  Cloud cover expected after midnight.\n</Callout>`
  }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Component Sandbox — labs.rjmlaird.co.uk</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: #0b0f1a;
        color: #eef2f6;
        font-family: "Inter", system-ui, sans-serif;
      }
      .wrap { max-width: 760px; margin: 0 auto; padding: 4rem 1.5rem; }
      a.back { color: #9aa5b1; text-decoration: none; font-size: 0.85rem; }
      h1 { font-family: "Space Grotesk", system-ui, sans-serif; font-size: 1.8rem; margin: 1rem 0 0.5rem; }
      .lede { color: #9aa5b1; line-height: 1.6; margin-bottom: 2.5rem; }
      .entry { margin-bottom: 2.5rem; }
      .entry h2 { font-family: "Space Grotesk", system-ui, sans-serif; font-size: 1.1rem; margin-bottom: 0.75rem; }
      .preview {
        border: 1px solid rgba(238, 242, 246, 0.08);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 0.75rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      pre {
        background: #121826;
        border: 1px solid rgba(238, 242, 246, 0.08);
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
        font-size: 0.8rem;
        color: #9aa5b1;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <a class="back" href="https://labs.rjmlaird.co.uk">← labs</a>
      <h1>Component Sandbox</h1>
      <p class="lede">
        A working gallery of the Astro UI blocks used across rjmlaird.co.uk —
        rendered live, with the source snippet underneath each one.
      </p>

      <div class="entry">
        <h2>Button</h2>
        <div class="preview">
          <Button variant="primary">Save changes</Button>
          <Button variant="secondary">Cancel</Button>
        </div>
        <pre><code>{entries[0].snippet}</code></pre>
      </div>

      <div class="entry">
        <h2>Card</h2>
        <div class="preview">
          <Card title="Observation window">Best visibility starts 22:40 local time.</Card>
        </div>
        <pre><code>{entries[1].snippet}</code></pre>
      </div>

      <div class="entry">
        <h2>Callout</h2>
        <div class="preview" style="flex-direction: column;">
          <Callout tone="info">Data refreshed 4 minutes ago.</Callout>
          <Callout tone="warning">Cloud cover expected after midnight.</Callout>
        </div>
        <pre><code>{entries[2].snippet}</code></pre>
      </div>
    </div>
  </body>
</html>
