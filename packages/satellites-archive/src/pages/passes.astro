---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<Layout title="Satellite Passes — labs.rjmlaird.co.uk">
  <div id="app">
    <Header
      crumb="passes"
      title="Satellite Passes"
      tagline="Predicted rise/max-elevation/set times for a location, with an approximate visual brightness estimate."
      active="passes"
    >
      <span slot="status">
        <span class="badge wait" id="statusBadge"><span class="bdot"></span><span id="statusBadgeText">pre-launch</span></span>
      </span>
      <div slot="stat-bar" class="stat-bar">
        <div class="location-form">
          <label class="field-label">Latitude
            <input type="number" id="latInput" step="0.0001" min="-90" max="90" placeholder="51.5074">
          </label>
          <label class="field-label">Longitude
            <input type="number" id="lonInput" step="0.0001" min="-180" max="180" placeholder="-0.1278">
          </label>
          <label class="field-label">Elevation (m)
            <input type="number" id="altInput" step="1" value="0">
          </label>
          <button id="locateBtn">📍 My location</button>
        </div>
        <div class="stat">
          <span class="lbl">Catalog</span>
          <select id="groupSelect" title="Celestrak GP group">
            <option value="visual" selected>Visual / Brightest</option>
            <option value="stations">Space Stations</option>
            <option value="active">Active Payloads</option>
            <option value="starlink">Starlink</option>
            <option value="gps-ops">GPS Operational</option>
            <option value="weather">Weather</option>
          </select>
        </div>
        <div class="stat">
          <span class="lbl">Window</span>
          <select id="windowSelect">
            <option value="24">24 h</option>
            <option value="48" selected>48 h</option>
            <option value="72">72 h</option>
            <option value="120">5 days</option>
          </select>
        </div>
        <div class="stat">
          <span class="lbl">Min elev.</span>
          <select id="minElevSelect">
            <option value="0">0°</option>
            <option value="10" selected>10°</option>
            <option value="20">20°</option>
            <option value="30">30°</option>
          </select>
        </div>
        <div class="checkbox-field">
          <input type="checkbox" id="visibleOnlyCheckbox" checked>
          <label for="visibleOnlyCheckbox">Visible passes only</label>
        </div>
        <div class="grow"></div>
        <button class="primary" id="predictBtn">Predict passes</button>
      </div>
    </Header>

    <div class="main">
      <div class="stats-wrap">
        <div class="section-head-static">
          <span class="st">Upcoming passes</span>
          <span class="note">sorted by rise time · local timezone</span>
        </div>
        <div class="pass-list" id="passList"></div>

        <div class="overlay" id="overlay">
          <div class="ring"></div>
          <div class="msg" id="overlayMsg">Enter a location and press Predict Passes.</div>
        </div>
      </div>

      <aside class="sidebar">
        <div class="stat" style="margin-bottom:16px;">
          <span class="lbl">Passes found</span><span class="val" id="statPasses">–</span>
        </div>
        <div class="stat" style="margin-bottom:16px;">
          <span class="lbl">Visible</span><span class="val" id="statVisible">–</span>
        </div>
        <div class="stat" style="margin-bottom:16px;">
          <span class="lbl">Next rise</span><span class="val" id="statNext">–</span>
        </div>
        <div class="stat" style="margin-bottom:16px;">
          <span class="lbl">Satellites scanned</span><span class="val" id="statScanned">–</span>
        </div>

        <hr class="sep">

        <div class="section-head"><span class="st">Conditions</span></div>
        <p class="methodology">
          <b>Dark sky</b> — sun below −6° and satellite sunlit: best chance of a naked-eye pass.<br>
          <b>Twilight</b> — sun between 0° and −6°: satellite may still be visible against a lit sky.<br>
          <b>Daylight</b> — sun above the horizon: not visible to the eye.<br>
          <b>In shadow</b> — satellite is in Earth's shadow: not sunlit, not visible regardless of sky.
        </p>

        <hr class="sep">

        <div class="section-head"><span class="st">Brightness estimate</span></div>
        <p class="methodology">
          Estimated magnitude uses satellite range, solar phase angle, and SATCAT's radar
          cross-section (RCS) as a rough proxy for reflective size. This is <b>not</b> a precise
          photometric prediction — real pass predictors rely on empirically observed
          per-satellite brightness data that isn't available from Celestrak. Treat the number as
          an order-of-magnitude guide: roughly, brighter (more negative) than 3–4 is usually
          easy to spot; fainter than 6 is typically not visible to the naked eye.
        </p>

        <hr class="sep">
        <a class="back-link" href="https://labs.rjmlaird.co.uk" target="_blank" rel="noopener">← labs.rjmlaird.co.uk</a>
      </aside>
    </div>

    <footer>
      <span>Data: <a href="https://celestrak.org/NORAD/elements/index.php?FORMAT=tle" target="_blank" rel="noopener">Celestrak GP/TLE</a> &amp; <a href="https://celestrak.org/pub/satcat.csv" target="_blank" rel="noopener">SATCAT</a>. Positions from client-side SGP4 propagation (satellite.js).</span>
      <span>passes · rjmlaird-labs</span>
    </footer>
  </div>
</Layout>

<script>
  import '../scripts/satellite-passes';
</script>
