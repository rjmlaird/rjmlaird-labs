---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'Ryan Laird Labs',
  description = 'Interactive graph experiments.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f1a" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="wrap site-header__inner">
          <a class="brand" href="/">Ryan Laird</a>
        </div>
      </header>

      <main class="site-main">
        <div class="wrap">
          <slot />
        </div>
      </main>

      <footer class="site-footer">
        <div class="wrap site-footer__inner">
          <p>Interactive graph experiments.</p>
        </div>
      </footer>
    </div>
  </body>
</html>
